#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
TARGET="$ROOT/target/classes"
if [ ! -f "$TARGET/com/nusantech/creditsimulator/Main.class" ]; then
    if command -v mvn >/dev/null 2>&1; then
        mvn -q -DskipTests package
    else
        mkdir -p "$TARGET"
        find src/main/java -name '*.java' -print > target/main-sources.txt
        javac --release 17 -encoding UTF-8 -d "$TARGET" @target/main-sources.txt
    fi
fi
exec java -cp "$TARGET" com.nusantech.creditsimulator.Main "$@"
